# Server
PORT=4000
NODE_ENV=production

# Database (Railway, Neon, Supabase, etc.)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=femstore
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_secure_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app

# WhatsApp (optional - for Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# VENDOR_WHATSAPP=54911xxxxxxxx

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
